<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CSVoom.ui.ViewModels"
        mc:Ignorable="d"
        x:Class="CSVoom.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Name="MainWindowElement"
        Title="{Binding WindowTitle}"
        Icon="avares://CSVoom/resource/csvoom-logo.png">
    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- Top bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="Import" Command="{Binding OpenCommand}" />
                <MenuItem Header="Export" Command="{Binding ExportCommand}" />
            </MenuItem>
            <MenuItem Header="Navigate" Command="{Binding NavigateCommand}" />
            <MenuItem Header="Find" Command="{Binding FindCommand}" />
            <MenuItem Header="Visibility" Command="{Binding VisibilityCommand}" />
            <MenuItem Header="Settings" Command="{Binding SettingsCommand}" />
            <MenuItem Header="Comparer" Command="{Binding ComparerCommand}" />
            <MenuItem Header="History">
                <MenuItem Header="Search Results" Command="{Binding SearchResultsCommand}" />
            </MenuItem>
        </Menu>
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            Margin="0,0,8,0">
            <Button Content="Cancel" 
                    Command="{Binding RunCommand}" 
                    IsEnabled="{Binding IsBusy}"
                    Foreground="White" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            x:Name="CsvDataGrid"
            ItemsSource="{Binding VisibleRows}"
            CanUserSortColumns="False"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            GridLinesVisibility="All"
            HeadersVisibility="All"
            SelectionMode="Extended" />

        <!-- Overlay Panels -->
        <Border Grid.Row="1"
                IsVisible="{Binding InlinePanelVisible}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{DynamicResource AppSecondaryBackground}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20"
                BoxShadow="0 4 20 0 #40000000"
                ZIndex="100">
            <Grid Margin="8">
                <!-- Settings Panel -->
                <StackPanel IsVisible="{Binding SettingsPanelVisible}" Spacing="8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="avares://CSVoom/resource/csvoom-logo.png" Width="32" Height="32" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="Gray" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                        <Button Content="Close" Command="{Binding CloseInlinePanelCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="400">
                        <StackPanel x:Name="SettingsFieldsContainer" Spacing="8" />
                    </ScrollViewer>
                    <Button Content="Save &amp; Apply" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right"
                            Margin="0,8,0,0" />
                </StackPanel>

                <!-- Navigate Panel -->
                <StackPanel IsVisible="{Binding NavigatePanelVisible}" Spacing="8">
                    <DockPanel>
                        <TextBlock Text="Navigate" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                        <Button Content="Close" Command="{Binding CloseInlinePanelCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Column:" VerticalAlignment="Center" />
                        <AutoCompleteBox ItemsSource="{Binding NavigateColumnOptions}" 
                                         Text="{Binding SelectedNavigateColumn, Mode=TwoWay}" 
                                         Width="200" MinimumPrefixLength="0"
                                         FilterMode="Contains"
                                         KeyDown="NavigateControl_KeyDown" />
                        <TextBlock Text="Row:" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SelectedNavigateRow, Mode=TwoWay}" 
                                 Width="100" PlaceholderText="Row number"
                                 KeyDown="NavigateControl_KeyDown" />
                        <Button Content="Go" Command="{Binding NavigateGoCommand}" />
                    </StackPanel>
                </StackPanel>


                <!-- Search Results Panel -->
                <StackPanel IsVisible="{Binding SearchResultsVisible}" Spacing="8">
                    <DockPanel>
                        <TextBlock Text="Search Results" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="5"/>
                        <Button Content="Close" Command="{Binding CloseInlinePanelCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DifferenceDetail">
                                    <Button Content="{Binding DisplayLabel}"
                                            Click="NavigateToMatch_Click"
                                            Tag="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            Margin="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Visibility Panel -->
                <StackPanel IsVisible="{Binding VisibilityPanelVisible}" Spacing="8">
                    <DockPanel>
                        <TextBlock Text="Visibility" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                        <Button Content="Close" Command="{Binding CloseInlinePanelCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="From:" VerticalAlignment="Center" />
                        <AutoCompleteBox ItemsSource="{Binding NavigateColumnOptions}" 
                                         Text="{Binding VisibilityStartColumn, Mode=TwoWay}" 
                                         Width="200" MinimumPrefixLength="0"
                                         FilterMode="Contains" />
                        <TextBlock Text="To:" VerticalAlignment="Center" />
                        <AutoCompleteBox ItemsSource="{Binding NavigateColumnOptions}" 
                                         Text="{Binding VisibilityEndColumn, Mode=TwoWay}" 
                                         Width="200" MinimumPrefixLength="0"
                                         FilterMode="Contains" />
                        <Button Content="Hide" Command="{Binding VisibilityApplyCommand}" CommandParameter="{x:False}" />
                        <Button Content="Unhide" Command="{Binding VisibilityApplyCommand}" CommandParameter="{x:True}" />
                    </StackPanel>
                </StackPanel>

                <!-- Find Panel -->
                <StackPanel IsVisible="{Binding FindPanelVisible}" Spacing="8">
                    <DockPanel>
                        <TextBlock Text="Find" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                        <Button Content="Close" Command="{Binding CloseInlinePanelCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    
                    <ItemsControl ItemsSource="{Binding FindCriteria}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4" x:DataType="vm:FindCriterion">
                                    <TextBlock Text="Text:" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding SearchText, Mode=TwoWay}" 
                                             Width="300" PlaceholderText="Search text (regex or &lt; &gt; = supported)"
                                             KeyDown="FindControl_KeyDown" />
                                    <TextBlock Text="Column:" VerticalAlignment="Center" />
                                    <AutoCompleteBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateColumnOptions}" 
                                                     Text="{Binding Column, Mode=TwoWay}" 
                                                     Width="200" MinimumPrefixLength="0"
                                                     FilterMode="Contains"
                                                     KeyDown="FindControl_KeyDown" />
                                    <Button Content="-" 
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveFindCriterionCommand}" 
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="+" Command="{Binding AddFindCriterionCommand}" />
                        <Button Content="Find" Command="{Binding ExecuteFindCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal">
                <TextBlock
                    Margin="8,8,8,8"
                    Text="{Binding StatusText}"
                    ToolTip.Tip="{Binding StatusText}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    FontSize="16"
                    TextTrimming="LeadingCharacterEllipsis" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Margin="8,8,8,8"
                Text="{Binding TotalRowsText}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="16" />
        </Grid>
    </Grid>
</Window>