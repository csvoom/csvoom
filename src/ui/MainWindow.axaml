<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CSVoom.ui.ViewModels"
        mc:Ignorable="d"
        x:Class="CSVoom.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Name="MainWindowElement"
        Title="{Binding WindowTitle}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="0">
        <!-- Top bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="Import file" Command="{Binding OpenCommand}" />
            <MenuItem Header="Export file" Command="{Binding ExportCommand}" />
            <MenuItem Header="Navigate" Command="{Binding NavigateCommand}" />
            <MenuItem Header="Command History" Command="{Binding CommandHistoryCommand}" />
            <MenuItem Header="Settings" Command="{Binding SettingsCommand}" />
            <MenuItem Header="Comparer" Command="{Binding ComparerCommand}" />
        </Menu>
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">
            <TextBlock
                Text="{Binding CommandExampleText}"
                HorizontalAlignment="Left"
                Opacity="0.7"
                FontSize="13" />
            <TextBox
                x:Name="CommandTextBox"
                Text="{Binding CommandText, Mode=TwoWay}"
                Watermark="Command. eg: load, find, hide..."
                KeyDown="CommandTextBox_KeyDown"
                HorizontalAlignment="Stretch"
                MinWidth="320" />
            <Button Content="{Binding RunButtonText}" Command="{Binding RunCommand}" />
        </StackPanel>

        <!-- Inline Panels -->
        <Border Grid.Row="1"
                IsVisible="{Binding InlinePanelVisible}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource AppSecondaryBackground}">
            <Grid Margin="8">
                <!-- Settings Panel -->
                <StackPanel IsVisible="{Binding SettingsPanelVisible}" Spacing="8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Settings" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="Gray" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                        <Button Content="Close" Command="{Binding CloseInlinePanelCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="400">
                        <StackPanel x:Name="SettingsFieldsContainer" Spacing="8" />
                    </ScrollViewer>
                    <Button Content="Save &amp; Apply" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right"
                            Margin="0,8,0,0" />
                </StackPanel>

                <!-- Navigate Panel -->
                <StackPanel IsVisible="{Binding NavigatePanelVisible}" Spacing="8">
                    <DockPanel>
                        <TextBlock Text="Navigate" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                        <Button Content="Close" Command="{Binding CloseInlinePanelCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Column:" VerticalAlignment="Center" />
                        <AutoCompleteBox ItemsSource="{Binding NavigateColumnOptions}" 
                                         Text="{Binding SelectedNavigateColumn, Mode=TwoWay}" 
                                         Width="200" MinimumPrefixLength="0"
                                         FilterMode="Contains" />
                        <TextBlock Text="Row:" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SelectedNavigateRow, Mode=TwoWay}" 
                                 Width="100" Watermark="Row number" />
                        <Button Content="Go" Command="{Binding NavigateGoCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Command History Panel -->
                <StackPanel IsVisible="{Binding CommandHistoryPanelVisible}" Spacing="8">
                    <DockPanel>
                        <TextBlock Text="Command History" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                        <Button Content="Close" Command="{Binding CloseInlinePanelCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding CommandHistory}" MaxHeight="300"
                             SelectionChanged="CommandHistoryListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="4" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Border>
        <DataGrid
            Grid.Row="3"
            x:Name="CsvDataGrid"
            ItemsSource="{Binding VisibleRows}"
            CanUserSortColumns="False"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            GridLinesVisibility="All"
            HeadersVisibility="All"
            SelectionMode="Extended" />
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal">
                <TextBlock
                    Margin="8,8,8,8"
                    Text="{Binding StatusText}"
                    ToolTip.Tip="{Binding StatusText}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    FontSize="16"
                    TextTrimming="LeadingCharacterEllipsis" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Margin="8,8,8,8"
                Text="{Binding TotalRowsText}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="16" />
        </Grid>
    </Grid>
</Window>